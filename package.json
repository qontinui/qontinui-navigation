{
  "name": "@qontinui/navigation",
  "version": "0.4.0",
  "description": "Shared navigation structure for Qontinui applications",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && node -e \"if(!require('fs').statSync('dist/index.d.ts').size)process.exit(1)\"",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@qontinui/ui-bridge": ">=0.3.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@qontinui/ui-bridge": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "qontinui",
    "navigation",
    "menu",
    "sidebar"
  ],
  "author": "Joshua Spinak",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/qontinui/qontinui-navigation.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "rollup": ">=4.59.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@qontinui/ui-bridge": "^0.3.2",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.7"
  }
}
